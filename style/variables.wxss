/* style/variables.wxss */
:root, page {
  /* 主色调 - 足球绿茵 */
  --bg-primary: #0D3010;
  --bg-secondary: #1B5E20;
  --bg-card: #1a3a2a;
  --bg-overlay: rgba(0, 0, 0, 0.6);

  /* 重点色 */
  --accent-green: #4CAF50;
  --accent-gold: #FFD700;
  --accent-white: #FFFFFF;
  --accent-red: #F44336;

  /* 文字色 */
  --text-primary: #FFFFFF;
  --text-secondary: rgba(255, 255, 255, 0.85);
  --text-muted: rgba(255, 255, 255, 0.55);

  /* 功能色 */
  --option-a: #2196F3;
  --option-b: #FF5722;
  --progress-bg: rgba(255, 255, 255, 0.15);
  --progress-fill: linear-gradient(90deg, #4CAF50, #FFD700);

  /* 间距 */
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 40rpx;
  --spacing-xl: 60rpx;

  /* 字体 */
  --font-size-xs: 24rpx;
  --font-size-sm: 28rpx;
  --font-size-md: 32rpx;
  --font-size-lg: 40rpx;
  --font-size-xl: 52rpx;
  --font-size-xxl: 72rpx;
}
