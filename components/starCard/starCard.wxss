/* components/starCard/starCard.wxss */
.star-card {
  width: 580rpx;
  height: 760rpx;
  position: relative;
  perspective: 1200rpx;
  cursor: pointer;
}

.card-front, .card-back {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  backface-visibility: hidden;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg);
  box-sizing: border-box;
}

.card-front {
  background: linear-gradient(145deg, #1a3a2a, #0D3010);
  border: 3rpx solid rgba(255, 215, 0, 0.3);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  transform: rotateY(0deg);
}

.flipped .card-front {
  transform: rotateY(180deg);
}

.card-back {
  background: linear-gradient(145deg, #2a1a0a, #1a0a00);
  border: 3rpx solid rgba(255, 215, 0, 0.4);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  transform: rotateY(-180deg);
}

.flipped .card-back {
  transform: rotateY(0deg);
}

.card-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.card-mbti {
  font-size: var(--font-size-sm);
  color: var(--accent-gold);
  font-weight: 700;
  background: rgba(255, 215, 0, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.card-country {
  font-size: 48rpx;
}

.card-avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,215,0,0.2), rgba(76,175,80,0.2));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
  border: 4rpx solid var(--accent-gold);
}

.avatar-placeholder {
  font-size: 100rpx;
}

.card-name {
  font-size: var(--font-size-xl);
  font-weight: 800;
  color: var(--accent-gold);
  margin-bottom: 8rpx;
}

.card-title {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}

.card-match-rate {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 215, 0, 0.1);
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.2);
}

.rate-label {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
}

.rate-value {
  font-size: var(--font-size-xxl);
  font-weight: 800;
  color: var(--accent-gold);
  line-height: 1.2;
}

/* 背面 */
.back-title {
  font-size: var(--font-size-lg);
  font-weight: 800;
  color: var(--accent-gold);
  margin-bottom: var(--spacing-md);
  text-align: center;
}

.back-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  line-height: 1.7;
  text-align: left;
  margin-bottom: var(--spacing-md);
  flex: 1;
}

.back-traits {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: var(--spacing-md);
}

.trait-tag {
  font-size: 22rpx;
  color: var(--accent-green);
  background: rgba(76, 175, 80, 0.15);
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(76, 175, 80, 0.3);
}

.back-quote {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  font-style: italic;
  text-align: center;
  padding: var(--spacing-sm);
  border-top: 2rpx solid rgba(255, 215, 0, 0.15);
  width: 100%;
}
