/* components/progressBar/progressBar.wxss */
.progress-bar {
  width: 100%;
  padding: 20rpx 0;
}

.progress-period {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.period-text {
  font-size: 24rpx;
  color: #FFD700;
  font-weight: 600;
}

.count-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 6rpx;
  position: relative;
  overflow: visible;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #FFD700);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-ball {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  transition: left 0.5s ease;
  z-index: 2;
}

.ball-icon {
  font-size: 32rpx;
}

/* 伤停补时模式 */
.stoppage .progress-fill {
  background: linear-gradient(90deg, #F44336, #FF5722);
  animation: progressPulse 0.8s infinite alternate;
}

@keyframes progressPulse {
  from { opacity: 1; }
  to { opacity: 0.6; }
}
