/* pages/quiz/quiz.wxss */
.page-quiz {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: var(--spacing-md);
  background: linear-gradient(180deg, #0D3010 0%, #1a4a1a 100%);
  position: relative;
}

/* 进度区 */
.progress-area {
  width: 100%;
  margin-bottom: var(--spacing-lg);
  padding-top: var(--spacing-md);
  flex-shrink: 0;
}

.period-label {
  font-size: var(--font-size-sm);
  color: var(--accent-gold);
  font-weight: 600;
  margin-bottom: var(--spacing-sm);
  text-align: center;
}

.stoppage-text {
  color: #F44336;
  animation: pulse 0.5s infinite alternate;
}

@keyframes pulse {
  from { opacity: 1; }
  to { opacity: 0.6; }
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: var(--progress-bg);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--progress-fill);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 题目区 - 弹性撑开 */
.quiz-body {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  transition: opacity 0.3s, transform 0.3s;
}

.quiz-body.slide-out {
  opacity: 0;
  transform: translateX(-60rpx);
}

.quiz-body.slide-in {
  opacity: 1;
  transform: translateX(0);
}

/* 题目内容 - 垂直居中 */
.quiz-content {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--spacing-md);
}

/* 维度标签 */
.dimension-tag {
  font-size: var(--font-size-xs);
  color: var(--accent-gold);
  background: rgba(255, 215, 0, 0.15);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: var(--spacing-md);
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  flex-shrink: 0;
}

/* 题目文字 */
.question-text {
  font-size: var(--font-size-lg);
  color: var(--text-primary);
  font-weight: 600;
  text-align: center;
  margin-bottom: var(--spacing-xl);
  line-height: 1.6;
  padding-top: var(--spacing-lg);
}

/* 选项按钮 */
.option {
  width: 90%;
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: var(--spacing-md);
  border-radius: 24rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
  box-sizing: border-box;
  cursor: pointer;
}

.option-a {
  background: rgba(33, 150, 243, 0.12);
  border-color: rgba(33, 150, 243, 0.3);
}

.option-b {
  background: rgba(255, 87, 34, 0.12);
  border-color: rgba(255, 87, 34, 0.3);
}

.option-a.selected-a {
  background: rgba(33, 150, 243, 0.25);
  border-color: #2196F3;
  transform: scale(1.02);
  box-shadow: 0 0 20rpx rgba(33, 150, 243, 0.2);
}

.option-b.selected-b {
  background: rgba(255, 87, 34, 0.25);
  border-color: #FF5722;
  transform: scale(1.02);
  box-shadow: 0 0 20rpx rgba(255, 87, 34, 0.2);
}

.option-indicator {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: var(--font-size-sm);
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.option-a .option-indicator {
  background: #2196F3;
  color: #fff;
}

.option-b .option-indicator {
  background: #FF5722;
  color: #fff;
}

.option-text {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  line-height: 1.5;
  flex: 1;
}

/* 底部导航 */
.bottom-nav {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding: var(--spacing-md) 0 var(--spacing-xl);
}

.nav-btn-area {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
}

.nav-btn {
  background: linear-gradient(135deg, #4CAF50, #FFD700);
  color: #1B5E20;
  font-size: var(--font-size-md);
  font-weight: 700;
  padding: 24rpx 80rpx;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(76, 175, 80, 0.4);
  transition: transform 0.2s;
}

.nav-btn:active {
  transform: scale(0.96);
}

.nav-hidden {
  visibility: hidden;
  pointer-events: none;
}

.nav-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
  max-width: 50%;
}

.nav-dot {
  width: 12rpx;
  min-width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #555;
  transition: all 0.3s;
  cursor: pointer;
}

.nav-dot.filled {
  background: #4CAF50;
  opacity: 1;
}

.nav-dot.active {
  background: #FFD700 !important;
  width: 24rpx;
  min-width: 24rpx;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.4);
}

/* 中场休息 */
.half-time-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  transition: opacity 0.5s;
  pointer-events: none;
}

.half-time-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.half-time-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl);
}

.ht-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-md);
}

.ht-title {
  font-size: var(--font-size-xl);
  color: var(--accent-gold);
  font-weight: 800;
  margin-bottom: var(--spacing-sm);
}

.ht-sub {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}

.ht-quote {
  font-size: var(--font-size-sm);
  color: var(--text-muted);
  font-style: italic;
  text-align: center;
  margin-bottom: 8rpx;
}

.ht-author {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  margin-bottom: var(--spacing-xl);
}

.ht-btn {
  background: linear-gradient(135deg, #4CAF50, #FFD700);
  color: #1B5E20;
  font-weight: 700;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
}
