/* pages/index/index.wxss */
.page-index {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: var(--spacing-lg);
  position: relative;
}

/* 主内容区垂直居中 */
.main-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: 100%;
}

/* 草皮背景 */
.bg-grass {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 60rpx,
      rgba(255,255,255,0.03) 60rpx,
      rgba(255,255,255,0.03) 61rpx
    ),
    linear-gradient(180deg, #0D3010 0%, #1B5E20 100%);
  z-index: 0;
}

/* 标题区 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  position: relative;
  z-index: 1;
}

.logo-area {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, var(--accent-gold), #FF8F00);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-md);
  box-shadow: 0 0 60rpx rgba(255, 215, 0, 0.4);
  animation: glow 2s infinite alternate;
}

@keyframes glow {
  from { box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.3); }
  to { box-shadow: 0 0 80rpx rgba(255, 215, 0, 0.6); }
}

.logo-emoji {
  font-size: 80rpx;
}

.title-main {
  font-size: var(--font-size-xxl);
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent-gold), #FF8F00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 8rpx;
}

.title-sub {
  font-size: var(--font-size-xs);
  color: var(--accent-gold);
  letter-spacing: 12rpx;
  margin-top: 8rpx;
  opacity: 0.8;
}

/* 副标题区 */
.slogan-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  position: relative;
  z-index: 1;
}

.slogan-text {
  font-size: var(--font-size-md);
  color: var(--accent-gold);
  font-weight: 600;
  text-align: center;
  padding: 16rpx 40rpx;
  background: rgba(255, 215, 0, 0.1);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.3);
  margin-bottom: var(--spacing-sm);
}

.desc-text {
  font-size: var(--font-size-sm);
  color: var(--text-muted);
}

/* 统计 */
.stats-area {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-xl);
  position: relative;
  z-index: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.stat-num {
  font-size: var(--font-size-xl);
  font-weight: 800;
  color: var(--accent-gold);
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* 开始按钮 */
.btn-start-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.btn-start {
  background: linear-gradient(135deg, #4CAF50, #FFD700);
  color: #1B5E20;
  font-size: var(--font-size-lg);
  font-weight: 700;
  padding: 28rpx 100rpx;
  border-radius: 60rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.5);
  transition: transform 0.2s, box-shadow 0.2s;
  letter-spacing: 4rpx;
}

.btn-start:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.btn-hint {
  font-size: var(--font-size-xs);
  color: var(--text-muted);
  margin-top: var(--spacing-md);
}

/* 底部足球 */
/* 底部声明 */
.footer-disclaimer {
  position: fixed;
  bottom: 24rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 10;
}

.disclaimer-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
}
